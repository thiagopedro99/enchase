diff -ruN a/src/tests/probe/contrast.test.tsx b/src/tests/probe/contrast.test.tsx
--- a/src/tests/probe/contrast.test.tsx	1970-01-01 00:00:00.000000000 +0000
+++ b/src/tests/probe/contrast.test.tsx	2026-10-08 18:48:15.518170477 +0000
@@ -0,0 +1,24 @@
+import { describe, expect, it, vi } from 'vitest'
+import { screen } from '@testing-library/react'
+import axeCore from 'axe-core'
+
+import { renderWithProviders } from '@tests/renderWithProviders.tsx'
+import { ConfirmModal } from '@components/common/Modal/index.tsx'
+
+const contrast = async (el: Element) => (await axeCore.run(el, { runOnly: ['color-contrast'] })).violations.length
+
+describe('contrast timing', () => {
+  for (const theme of ['light', 'dark'] as const) {
+    it(`ConfirmModal primary button contrast (${theme}) immediately vs after animation`, async () => {
+      renderWithProviders(<ConfirmModal isOpen onClose={vi.fn()} onConfirm={vi.fn()} message="Delete?" />, { theme })
+      const dialog = await screen.findByRole('alertdialog')
+      const btn = screen.getByRole('button', { name: 'Confirmar' })
+      const early = await contrast(dialog)
+      const earlyOpacity = getComputedStyle(dialog).opacity
+      await new Promise((r) => setTimeout(r, 800))
+      const late = await contrast(dialog)
+      console.log(`[contrast] ${theme} early=${early} (opacity ${earlyOpacity}) late=${late} bg=${getComputedStyle(btn).backgroundColor} fg=${getComputedStyle(btn).color}`)
+      expect(late).toBe(0)
+    })
+  }
+})
diff -ruN a/src/tests/probe/realBrowser.test.tsx b/src/tests/probe/realBrowser.test.tsx
--- a/src/tests/probe/realBrowser.test.tsx	1970-01-01 00:00:00.000000000 +0000
+++ b/src/tests/probe/realBrowser.test.tsx	2026-10-08 18:48:15.518359240 +0000
@@ -0,0 +1,91 @@
+import { describe, expect, it } from 'vitest'
+import { screen, waitFor } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+
+import { ControlledDialog } from '@tests/shared/contracts/dialogHarness.tsx'
+import { renderWithProviders } from '@tests/renderWithProviders.tsx'
+import { Modal } from '@components/common/Modal/index.tsx'
+
+const isBrowser = !navigator.userAgent.includes('jsdom')
+
+const renderModal = () =>
+  renderWithProviders(
+    <ControlledDialog>
+      {({ open, close }) => (
+        <>
+          <div data-testid="tall" style={{ height: '5000px' }} />
+          <Modal isOpen={open} onClose={close} title="Edit profile" footer={<button>Save</button>}>
+            <input aria-label="Name" />
+          </Modal>
+        </>
+      )}
+    </ControlledDialog>
+  )
+
+const open = async () => {
+  const user = userEvent.setup()
+  renderModal()
+  const trigger = screen.getByRole('button', { name: 'Open' })
+  await user.click(trigger)
+  const dialog = await screen.findByRole('dialog')
+  return { user, trigger, dialog }
+}
+
+describe(`probe (${isBrowser ? 'browser' : 'jsdom'})`, () => {
+  it('inert really blocks programmatic focus on the page behind', async () => {
+    const { trigger, dialog } = await open()
+    trigger.focus()
+    expect(dialog).toContainElement(document.activeElement as HTMLElement)
+  })
+
+  it('backdrop is the hit-test target outside the dialog box', async () => {
+    const { dialog } = await open()
+    const hit = document.elementFromPoint(5, 5)
+    expect(hit).toBe(dialog.previousElementSibling)
+  })
+
+  it('Tab lands on an element that matches :focus-visible with a visible outline', async () => {
+    const { user } = await open()
+    await user.tab()
+    const active = document.activeElement as HTMLElement
+    expect(active.matches(':focus-visible')).toBe(true)
+    expect(getComputedStyle(active).outlineStyle).not.toBe('none')
+  })
+
+  it('CSS modules are applied (backdrop is position: fixed)', async () => {
+    const { dialog } = await open()
+    expect(getComputedStyle(dialog.previousElementSibling as Element).position).toBe('fixed')
+  })
+
+  it('exit animation keeps the dialog mounted for a measurable time', async () => {
+    const { user } = await open()
+    const start = performance.now()
+    await user.keyboard('{Escape}')
+    await waitFor(() => expect(screen.queryByRole('dialog')).not.toBeInTheDocument())
+    const elapsed = performance.now() - start
+    console.log(`[probe] exit took ${elapsed.toFixed(0)}ms`)
+    expect(elapsed).toBeGreaterThan(50)
+  })
+
+  it.skipIf(!isBrowser)('wheel does not scroll the page while open, and does after close', async () => {
+    const { commands } = await import('vitest/browser')
+    const wheel = (commands as unknown as { wheelAt: (x: number, y: number, dy: number) => Promise<void> }).wheelAt
+    const { user } = await open()
+    window.scrollTo(0, 0)
+    await wheel(5, 5, 600)
+    await new Promise((r) => setTimeout(r, 200))
+    const lockedY = window.scrollY
+    await user.keyboard('{Escape}')
+    await waitFor(() => expect(screen.queryByRole('dialog')).not.toBeInTheDocument())
+    await wheel(5, 5, 600)
+    await new Promise((r) => setTimeout(r, 200))
+    console.log(`[probe] scrollY locked=${lockedY} after=${window.scrollY}`)
+    expect(lockedY).toBe(0)
+    expect(window.scrollY).toBeGreaterThan(0)
+  })
+
+  it('matchMedia for prefers-reduced-motion reflects the environment', () => {
+    console.log(`[probe] reduce=${window.matchMedia('(prefers-reduced-motion: reduce)').matches} mm-is-mock=${!String(window.matchMedia).includes('[native code]')}`)
+    expect(true).toBe(true)
+  })
+})
diff -ruN a/src/tests/probe/tooltipGlide.test.tsx b/src/tests/probe/tooltipGlide.test.tsx
--- a/src/tests/probe/tooltipGlide.test.tsx	1970-01-01 00:00:00.000000000 +0000
+++ b/src/tests/probe/tooltipGlide.test.tsx	2026-10-08 18:48:15.517968866 +0000
@@ -0,0 +1,34 @@
+import { describe, expect, it } from 'vitest'
+import { screen } from '@testing-library/react'
+
+import { renderWithProviders } from '@tests/renderWithProviders.tsx'
+import { Tooltip } from '@components/common/Tooltip/index.tsx'
+
+type Glide = (x1: number, y1: number, x2: number, y2: number, steps: number, pause: number) => Promise<void>
+
+describe('tooltip hoverable with a real pointer path', () => {
+  for (const [steps, pause] of [[5, 10], [10, 20], [10, 40]] as const) {
+    it(`stays open when the pointer glides from trigger to bubble (${steps} steps x ${pause}ms)`, async () => {
+      const { commands } = await import('vitest/browser')
+      const glide = (commands as unknown as { glide: Glide }).glide
+      renderWithProviders(
+        <div style={{ padding: '120px' }}>
+          <Tooltip text="Save changes">
+            <button>Save</button>
+          </Tooltip>
+        </div>
+      )
+      const button = screen.getByRole('button', { name: 'Save' })
+      const b = button.getBoundingClientRect()
+      await glide(b.left + b.width / 2, b.top + b.height / 2, b.left + b.width / 2, b.top + b.height / 2 + 1, 1, 0)
+      const bubble = await screen.findByText('Save changes', { selector: '[aria-hidden="true"]' })
+      await new Promise((r) => setTimeout(r, 300))
+      const t = bubble.getBoundingClientRect()
+      const gap = b.top - t.bottom
+      await glide(b.left + b.width / 2, b.top + b.height / 2, t.left + t.width / 2, t.top + t.height / 2, steps, pause)
+      await new Promise((r) => setTimeout(r, 400))
+      console.log(`[glide] gap=${gap.toFixed(1)}px steps=${steps} pause=${pause} open=${document.body.contains(bubble)}`)
+      expect(document.body.contains(bubble)).toBe(true)
+    })
+  }
+})
