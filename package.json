{
  "name": "enchase",
  "version": "0.21.1",
  "description": "Accessible React components with a validated theme, CSS-first motion, SSR and RTL support, and no runtime dependency besides React",
  "license": "MIT",
  "author": "Thiago Silva (https://github.com/thiagopedro99)",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "browserslist": [
    "chrome >= 120",
    "edge >= 120",
    "firefox >= 129",
    "safari >= 17.5",
    "ios_saf >= 17.5"
  ],
  "keywords": [
    "react",
    "components",
    "accessibility",
    "a11y",
    "design-system",
    "theming",
    "css-modules",
    "ssr",
    "rtl",
    "typescript"
  ],
  "homepage": "https://enchase.othiagosilva.com.br/docs/",
  "bugs": {
    "url": "https://github.com/thiagopedro99/enchase/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thiagopedro99/enchase.git"
  },
  "bin": {
    "enchase": "bin/enchase.mjs"
  },
  "files": [
    "dist-lib",
    "eject",
    "bin",
    "EJECT.md",
    "HEADLESS.md",
    "VERSIONING.md",
    "SECURITY.md",
    "ACCESSIBILITY.md",
    "MIGRATION.md",
    "docs/migration",
    "README.md",
    "API.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist-lib/types/lib/index.d.ts",
      "import": "./dist-lib/index.js",
      "default": "./dist-lib/index.js"
    },
    "./theme": {
      "types": "./dist-lib/types/lib/theme.d.ts",
      "import": "./dist-lib/theme.js",
      "default": "./dist-lib/theme.js"
    },
    "./locales": {
      "types": "./dist-lib/types/lib/locales.d.ts",
      "import": "./dist-lib/locales.js",
      "default": "./dist-lib/locales.js"
    },
    "./icons": {
      "types": "./dist-lib/types/lib/icons.d.ts",
      "import": "./dist-lib/icons.js",
      "default": "./dist-lib/icons.js"
    },
    "./headless/tabs": {
      "types": "./dist-lib/types/lib/headless/tabs.d.ts",
      "import": "./dist-lib/headless/tabs.js",
      "default": "./dist-lib/headless/tabs.js"
    },
    "./headless/pagination": {
      "types": "./dist-lib/types/lib/headless/pagination.d.ts",
      "import": "./dist-lib/headless/pagination.js",
      "default": "./dist-lib/headless/pagination.js"
    },
    "./headless/segmented-control": {
      "types": "./dist-lib/types/lib/headless/segmented-control.d.ts",
      "import": "./dist-lib/headless/segmented-control.js",
      "default": "./dist-lib/headless/segmented-control.js"
    },
    "./headless/accordion": {
      "types": "./dist-lib/types/lib/headless/accordion.d.ts",
      "import": "./dist-lib/headless/accordion.js",
      "default": "./dist-lib/headless/accordion.js"
    },
    "./headless/slider": {
      "types": "./dist-lib/types/lib/headless/slider.d.ts",
      "import": "./dist-lib/headless/slider.js",
      "default": "./dist-lib/headless/slider.js"
    },
    "./experimental/tabs": {
      "types": "./dist-lib/types/lib/experimental/tabs.d.ts",
      "import": "./dist-lib/experimental/tabs.js",
      "default": "./dist-lib/experimental/tabs.js"
    },
    "./experimental/pagination": {
      "types": "./dist-lib/types/lib/experimental/pagination.d.ts",
      "import": "./dist-lib/experimental/pagination.js",
      "default": "./dist-lib/experimental/pagination.js"
    },
    "./experimental/segmented-control": {
      "types": "./dist-lib/types/lib/experimental/segmented-control.d.ts",
      "import": "./dist-lib/experimental/segmented-control.js",
      "default": "./dist-lib/experimental/segmented-control.js"
    },
    "./experimental/accordion": {
      "types": "./dist-lib/types/lib/experimental/accordion.d.ts",
      "import": "./dist-lib/experimental/accordion.js",
      "default": "./dist-lib/experimental/accordion.js"
    },
    "./experimental/slider": {
      "types": "./dist-lib/types/lib/experimental/slider.d.ts",
      "import": "./dist-lib/experimental/slider.js",
      "default": "./dist-lib/experimental/slider.js"
    },
    "./styles/enchase": {
      "types": "./dist-lib/types/lib/styles/enchase.d.ts",
      "import": "./dist-lib/styles/enchase.js",
      "default": "./dist-lib/styles/enchase.js"
    },
    "./styles/shadcn": {
      "types": "./dist-lib/types/lib/styles/shadcn.d.ts",
      "import": "./dist-lib/styles/shadcn.js",
      "default": "./dist-lib/styles/shadcn.js"
    },
    "./styles/workbench": {
      "types": "./dist-lib/types/lib/styles/workbench.d.ts",
      "import": "./dist-lib/styles/workbench.js",
      "default": "./dist-lib/styles/workbench.js"
    },
    "./styles.css": "./dist-lib/styles.css",
    "./styles.layer.css": "./dist-lib/styles.layer.css",
    "./theme.css": "./dist-lib/theme.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "type-check": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "npm run build:lib && vitest run --config vitest.browser.config.ts",
    "test:browser:firefox": "node scripts/runBrowserTests.mjs firefox",
    "test:browser:webkit": "node scripts/runBrowserTests.mjs webkit",
    "test:browser:repeat": "node scripts/repeatBrowserTests.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/fixDeclarations.mjs && node scripts/deprecateExperimental.mjs && node scripts/buildCssOutputs.mjs && node scripts/buildEject.mjs && node scripts/checkPackage.mjs",
    "pack:check": "npm pack --dry-run && publint && attw --pack . --profile esm-only --exclude-entrypoints ./styles.css ./styles.layer.css ./theme.css",
    "test:consumer": "node scripts/testConsumer.mjs",
    "test:next": "node scripts/testNext.mjs",
    "test:eject": "node scripts/testEject.mjs",
    "test:size": "node scripts/testBundleSize.mjs",
    "check:api": "node scripts/checkApi.mjs",
    "test:stories-a11y": "node scripts/auditStories.mjs",
    "docs:api": "node scripts/buildApiDocs.mjs",
    "docs:api:check": "node scripts/buildApiDocs.mjs --check",
    "changelog": "node scripts/release.mjs preview",
    "release": "node scripts/release.mjs prepare",
    "prepublishOnly": "npm run docs:api:check && npm run build:lib && npm run test:size"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.25.0",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@hookform/resolvers": "6.0.2",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.15.20",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.3",
    "axe-core": "^4.13.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "publint": "^0.3.25",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "7.91.0",
    "storybook": "^10.6.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vitest-axe": "^0.1.0",
    "zod": "4.6.7"
  }
}
